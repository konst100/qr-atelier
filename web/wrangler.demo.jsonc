{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qr-atelier-demo",
  "main": "cloudflare/demo-worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
